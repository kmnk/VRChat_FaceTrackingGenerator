// Values that VIVE Focus Vision is said to send through VRCFaceTracking, as avatar parameters (v2/<name>).
// Focus Vision has no column in the VRCFT tables; the Focus 3 / XR Elite column is used (VRCFT says its eye tracking is the same as Focus 3).
// Simplified parameters first, then the Unified Expressions keys marked yes or partial in the VRCFT tables:
//   https://docs.vrcft.io/docs/hardware/interface-compatibilities
//   https://docs.vrcft.io/docs/tutorial-avatars/tutorial-avatars-extras/parameters
// Not checked against the values VRCFT really sends. Used by the settings editor preview only.
{
  "name": "VIVE Focus Vision",
  "keys": [
    {"key": "v2/EyeLeftX", "min": -1, "max": 1},
    {"key": "v2/EyeLeftY", "min": -1, "max": 1},
    {"key": "v2/EyeRightX", "min": -1, "max": 1},
    {"key": "v2/EyeRightY", "min": -1, "max": 1},
    {"key": "v2/EyeLidLeft", "min": 0, "max": 1},
