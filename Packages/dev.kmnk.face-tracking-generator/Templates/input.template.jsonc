// Input layer: the values the state machines' transitions compare (the Animator reads them). The rows of neutral and
// the states do not need inputs: they use the tracking keys directly.
// Each input is made in the avatar's Face Tracking section (Forward to Animator) from the face tracking keys. Only the
// inputs a transition uses are forwarded. Inputs are not synced: every client makes them from the face tracking data.
// "key" names the value (v2/<name>, as in VRCFaceTracking); the tool knows the expression of the values in
// Templates/Devices. "expression" writes your own, with the key names of the Face Tracking section, Voice and Viseme_*,
// numbers, + - * /, abs, min, max and clamp.
// Input names cannot contain ":".
// Copy this file to Settings/ and edit the copy.
{
  // Keys this device does not send. Inputs, rows and transitions that use them are dropped.
  "missing": [],

  "inputs": {
    // The template's state machine Emotion: joy, angry and sad come with these.
    "Smile": { "key": "v2/Smile", "expression": "max(MouthCornerPullLeft, MouthCornerPullRight)" },
    "BrowDown": { "key": "v2/BrowDown", "expression": "max(BrowLowererLeft, BrowLowererRight)" },
    "Frown": { "key": "v2/Frown", "expression": "max(MouthFrownLeft, MouthFrownRight)" }
  }
}
