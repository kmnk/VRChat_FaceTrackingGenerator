// Avatar layer: what is different for each avatar.
// Copy this file to Settings/ and edit the copy. Paths of the other tables are relative to this file.
{
  "name": "MyAvatar",
  "tables": { "expression": "expression.jsonc" },

  // The avatar prefab. Its Avatar Descriptor gives the FX, Gesture and Action controllers and the
  // Expression Parameters. The generator copies them and never changes the originals.
  "prefab": { "guid": "", "path": "Assets/MyAvatar/MyAvatar.prefab" },
  // A Prefab Variant that gets the generated controllers. Without "variant" it is
  // Assets/FaceTrackingGeneratorOutput/<name>/<name>_FT.prefab. Write a path to put it elsewhere:
  // "variant": "Assets/MyAvatar/MyAvatar_FT.prefab",
  // The folder for the generated controllers and Expression Parameters (default shown):
  // "outputFolder": "Assets/FaceTrackingGeneratorOutput/MyAvatar",

  // Part name -> blendshape. "mesh" is the renderer path from the avatar root. It starts empty: the settings
  // editor's Avatar tab lists each part the expression layer uses as Not set, to choose its blendshape there.
  // A part is written as "jaw.jawOpen": "<blendshape>", or with its own mesh "brow.browInnerUp": { "mesh": "Body", "shape": "<blendshape>" }.
  // "scale" (0 to 1, default 1) corrects the strength of this avatar's blendshape: it multiplies the expression layer's
  // strengths and fixed amounts, without changing a shared expression layer: "lip.mouthSmileLeft": { "shape": "<blendshape>", "scale": 0.7 }
  "mesh": "Body",
  "parts": {},
  // Parts in the expression layer that this avatar does not have.
  "missingParts": [],

  // The avatar's Face Tracking section (the generator writes the Prefab Variant and the build-time copy, never the
  // original prefab). The generator writes Blendshapes Sets and Eye Look there. When the avatar already
  // has its own values there (Blendshapes Sets with tracking rows, Parameter Behaviors that move blendshapes, Eye Look on
  // Face Tracking), they are kept and the generator's sets are not written, unless this is true. Viseme rows and the
  // avatar's Forward to Animator behaviors are always kept.
  "overwriteFaceTracking": false,
  // Eye Look's Eye Gaze Mode: "FaceTracking" (eye blendshapes from the EyeLook keys), "Both" (also the eye bones) or
  // "BoneRotation" (eye bones only). Choose Both or BoneRotation for an avatar that looks with its eye bones.
  "eyeGazeMode": "FaceTracking",

  // Menu toggle for FT, and the flag that plays the AFK animation.
  "faceTrackParameter": "FaceTrack",
  "afkPlayParameter": "AFKPlay",
  // The menu that gets the two toggles ("Fill prefab, mesh and menu" in the window writes the root menu).
  "menu": { "guid": "", "path": "Assets/MyAvatar/Menu.asset" },
  // Names of the toggles in the menu, and a submenu to put them in (null: directly in "menu").
  "faceTrackLabel": "FaceTrack",
  "afkPlayLabel": "AFK",
  "subMenu": null,

  // Parameters that mean AFK, and seconds to wait after they all turn off before FT comes back.
  // Wait for the avatar's own AFK layer to restore tracking.
  "afkGroups": [ { "parameters": ["AFK"], "wait": 6 } ],


  // Changes to the avatar's own layers in the copied controllers.
  "layers": {
    "fx": {
      "remove": [],
      "weights": {},
      // Hand gesture layers that must not change the face while FT is on.
      "stopWhileFaceTrack": ["Left Hand", "Right Hand"]
    }
  },

  // AFK animation clips. Choose them in the generator window, or write them here.
  "afkClips": {
    "actionIntro": null, "actionLoop": null, "actionOutro": null,
    "fxIntro": null, "fxLoop": null, "fxOutro": null
  }
}
